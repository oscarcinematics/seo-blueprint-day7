#!/usr/bin/env bash
# Link a site folder to this engine. Safe to run again on the same folder.
#
#   link-engine <site folder> [--port N]
#
# Used by new-site, and by adopt-site for sites that already exist.
#   - symlinks <site>/code, <site>/references and <site>/.claude/commands to
#     the engine. Only .claude/commands is linked, never the whole .claude,
#     so a site's own .claude/settings.local.json stays its own.
#   - writes <site>/CLAUDE.md (imports the engine's CLAUDE.md, with empty
#     "## My setup" and "## Design" sections) if the site has none yet.
#   - makes sure <site>/.env has DEV_PORT: --port N sets it, an existing
#     value is kept, otherwise the next free port from 3101 is picked.
#   - installs the engine's design tools (Playwright) once, if missing.
# It never touches anything inside <site>/website/.
set -euo pipefail

ENGINE="$(cd "$(dirname "$(realpath "$0")")" && pwd -P)"
SITES_DIR="${SITES_DIR:-$HOME/sites}"

die() { echo "link-engine: $*" >&2; exit 1; }

SITE_ARG="" PORT_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --port) [ $# -ge 2 ] || die "--port needs a number"; PORT_ARG="$2"; shift 2 ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) [ -z "$SITE_ARG" ] || die "one site folder only"; SITE_ARG="$1"; shift ;;
  esac
done
[ -n "$SITE_ARG" ] || die "usage: link-engine <site folder> [--port N]"
[ -d "$SITE_ARG" ] || die "no such folder: $SITE_ARG"
SITE="$(cd "$SITE_ARG" && pwd -P)"
[ "$SITE" != "$ENGINE" ] || die "that is the engine itself, not a site"
if [ -n "$PORT_ARG" ]; then
  case "$PORT_ARG" in ''|*[!0-9]*) die "--port must be a number, got: $PORT_ARG" ;; esac
fi

# path inside the site | engine path it points to
LINKS="code|code
references|references
.claude/commands|.claude/commands"

# Check everything before changing anything.
while IFS='|' read -r rel target; do
  dst="$SITE/$rel"
  [ -e "$ENGINE/$target" ] || die "the engine has no $target"
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    die "$dst already exists and is not a link. Move it aside first."
  fi
done <<EOF
$LINKS
EOF

mkdir -p "$SITE/.claude"
while IFS='|' read -r rel target; do
  dst="$SITE/$rel" src="$ENGINE/$target"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    echo "  ok      $rel -> $src"
    continue
  fi
  [ -L "$dst" ] && rm "$dst"
  ln -s "$src" "$dst"
  echo "  linked  $rel -> $src"
done <<EOF
$LINKS
EOF

# CLAUDE.md: import the engine's, plus this site's own sections.
if [ -e "$SITE/CLAUDE.md" ]; then
  echo "  kept    CLAUDE.md (already there)"
else
  case "$ENGINE" in
    "$HOME"/*) import="~${ENGINE#"$HOME"}/CLAUDE.md" ;;
    *) import="$ENGINE/CLAUDE.md" ;;
  esac
  cat > "$SITE/CLAUDE.md" <<EOF
# $(basename "$SITE")

@$import

## My setup

## Design
EOF
  echo "  wrote   CLAUDE.md (imports $import)"
fi

# DEV_PORT in .env
env_port() { # the DEV_PORT in one .env file, digits only
  [ -f "$1" ] || return 0
  { grep -E '^[[:space:]]*(export[[:space:]]+)?DEV_PORT=' "$1" || true; } | tail -1 | cut -d= -f2- | tr -dc '0-9'
}

next_free_port() {
  local used=" " f p
  for f in "$SITES_DIR"/*/.env; do
    [ -f "$f" ] || continue
    p="$(env_port "$f")"
    [ -n "$p" ] && used="$used$p "
  done
  p=3101
  while :; do
    case "$used" in *" $p "*) p=$((p + 1)); continue ;; esac
    if lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then p=$((p + 1)); continue; fi
    echo "$p"
    return 0
  done
}

current="$(env_port "$SITE/.env")"
if [ -n "$PORT_ARG" ]; then port="$PORT_ARG"
elif [ -n "$current" ]; then port="$current"
else port="$(next_free_port)"
fi

if [ "$port" = "$current" ]; then
  echo "  ok      .env DEV_PORT=$port"
else
  tmp="$(mktemp)"
  if [ -f "$SITE/.env" ]; then
    grep -vE '^[[:space:]]*(export[[:space:]]+)?DEV_PORT=' "$SITE/.env" > "$tmp" || true
    # keep a final newline before appending
    [ -s "$tmp" ] && [ -n "$(tail -c1 "$tmp")" ] && echo >> "$tmp"
  else
    echo "# This site's keys. The engine's shared keys live in $ENGINE/.env" > "$tmp"
  fi
  echo "DEV_PORT=$port" >> "$tmp"
  cat "$tmp" > "$SITE/.env"
  rm -f "$tmp"
  echo "  set     .env DEV_PORT=$port"
fi

# The design tools need Playwright, installed once in the engine.
if [ ! -d "$ENGINE/code/design/node_modules/playwright" ]; then
  echo "  installing the design tools (Playwright) in $ENGINE/code/design"
  (cd "$ENGINE/code/design" && npm install --silent --no-fund --no-audit)
fi
